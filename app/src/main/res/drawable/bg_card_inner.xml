<?xml version="1.0" encoding="utf-8"?>
<!--
  内嵌玻璃卡片背景（浅色，radius 16dp）—— 与 bg_card 同款质感配方：
  88% 白玻璃 + 55% 白高光描边 + 两层递减柔影。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 环境阴影层（最外，最淡） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A000000" />
            <corners android:radius="17dp" />
        </shape>
    </item>

    <!-- 接触阴影层 -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#11000000" />
            <corners android:radius="16.5dp" />
        </shape>
    </item>

    <!-- 主卡片：88% 白玻璃 + 白高光描边 -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#E0FFFFFF" />
            <corners android:radius="16dp" />
            <stroke android:width="0.5dp" android:color="#8CFFFFFF" />
        </shape>
    </item>

</layer-list>
