<?xml version="1.0" encoding="utf-8"?>
<!--
  预渲染毛玻璃背景（深色）—— Layer 1 深色变体
  色斑位置与浅色版一致，颜色取 values-night 中的提亮色，
  透明度整体调低（深色底上过亮会显脏）。

  注意：shape 必须用 rectangle（不能用 oval）——
  渐变会被裁剪在 shape 路径内，oval 路径是"内切全屏的椭圆"，
  会把贴边色斑削出一条椭圆弧线。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底色（与深色 bg_primary 一致） -->
    <item android:drawable="@color/bg_primary" />

    <!-- 色斑 1：green_primary(深色提亮 #9DAD8E)，左上 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.08"
                android:centerY="0.04"
                android:gradientRadius="260dp"
                android:startColor="#339DAD8E"
                android:endColor="#009DAD8E" />
        </shape>
    </item>

    <!-- 色斑 2：brown_light(深色 #D4B78D)，右上偏中 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.96"
                android:centerY="0.18"
                android:gradientRadius="230dp"
                android:startColor="#29D4B78D"
                android:endColor="#00D4B78D" />
        </shape>
    </item>

    <!-- 色斑 3：辅助淡绿(深色减淡)，左中 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.04"
                android:centerY="0.46"
                android:gradientRadius="220dp"
                android:startColor="#24A7C4A0"
                android:endColor="#00A7C4A0" />
        </shape>
    </item>

    <!-- 色斑 4：brown_accent(深色 #C8B9AA)，右下偏中 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.90"
                android:centerY="0.62"
                android:gradientRadius="240dp"
                android:startColor="#29C8B9AA"
                android:endColor="#00C8B9AA" />
        </shape>
    </item>

    <!-- 色斑 5：brown_dropdown(深色)，底部中间 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.30"
                android:centerY="0.96"
                android:gradientRadius="200dp"
                android:startColor="#1FD4B78D"
                android:endColor="#00D4B78D" />
        </shape>
    </item>

    <!-- 色斑 6：辅助淡绿(深色减淡)，中上偏右 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.60"
                android:centerY="0.30"
                android:gradientRadius="190dp"
                android:startColor="#24A7C4A0"
                android:endColor="#00A7C4A0" />
        </shape>
    </item>

</layer-list>
