<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_dialog"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp"
        android:minWidth="280dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_mode_icon"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mic"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/audio_recording" />

            <com.example.lifetrack.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="80dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_recording"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvRecordingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="00:00"
            android:textColor="@color/green_primary"
            android:textSize="28sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvRecordingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_recording_hint"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStopRecording"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/audio_stop_recording"
            android:textSize="15sp"
            android:letterSpacing="0.08"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_submit_ripple" />

    </LinearLayout>

    <ImageView
        android:id="@+id/btnDialogClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_dialog_close"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/dialog_close" />

</FrameLayout>
