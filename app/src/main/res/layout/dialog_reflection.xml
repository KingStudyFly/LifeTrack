<?xml version="1.0" encoding="utf-8"?>
<!-- 回顾感想对话框：上半显示日记原文，下半显示感想列表 + 输入框 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:padding="20dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 日记原文区 -->
        <TextView
            android:id="@+id/tvReflectionDiaryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:letterSpacing="0.03"
            tools:text="2025-07-03 14:30" />

        <TextView
            android:id="@+id/tvReflectionDiaryTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/green_primary"
            android:textSize="10sp"
            android:letterSpacing="0.05"
            tools:text="#梦境 #思考" />

        <TextView
            android:id="@+id/tvReflectionDiaryContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tips_bar"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="5dp"
            tools:text="日记原文内容..." />

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@color/border_light"
            android:importantForAccessibility="no" />

        <!-- 感想列表标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reflection_list_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="8dp" />

        <!-- 感想列表容器（动态添加 item_reflection） -->
        <LinearLayout
            android:id="@+id/reflectionListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 空状态 -->
        <TextView
            android:id="@+id/tvReflectionEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:visibility="gone"
            android:text="@string/reflection_empty_hint" />

        <!-- 感想输入区 -->
        <EditText
            android:id="@+id/editReflectionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_tips_bar"
            android:hint="@string/reflection_input_hint"
            android:textColorHint="@color/text_hint"
            android:textColor="@color/text_input"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:maxLines="4"
            android:maxLength="500" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnReflectionCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reflection_cancel"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_toolbar_btn_ripple" />

            <TextView
                android:id="@+id/btnReflectionSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reflection_save"
                android:textColor="@color/green_primary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_save_btn_pill_ripple" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
