<?xml version="1.0" encoding="utf-8"?>
<!-- 单条回顾感想项 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tips_bar"
    android:padding="10dp"
    android:layout_marginBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvReflectionDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:letterSpacing="0.03"
            tools:text="2026-07-03 15:00" />

        <TextView
            android:id="@+id/btnReflectionDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reflection_delete"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_toolbar_btn_ripple" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvReflectionContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        tools:text="一年前的我原来是这样想的啊..." />

</LinearLayout>
