<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/usageDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_chevron_left"
                android:padding="12dp"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/usage_detail_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_usage_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUsageTotalDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0m"
                        android:textColor="@color/green_primary"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_usage_total_duration"
                        android:textColor="@color/text_subtitle"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUsageDaysUsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textColor="@color/green_primary"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_usage_days_used"
                        android:textColor="@color/text_subtitle"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUsageAvgDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0m"
                        android:textColor="@color/green_primary"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_usage_avg_duration"
                        android:textColor="@color/text_subtitle"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/border_light" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUsageTodayDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0m"
                        android:textColor="@color/brown_accent"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_usage_today_duration"
                        android:textColor="@color/text_subtitle"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUsageTotalOpens"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textColor="@color/brown_accent"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_usage_total_opens"
                        android:textColor="@color/text_subtitle"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvUsageTodayOpens"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textColor="@color/brown_accent"
                        android:textSize="20sp"
                        android:fontFamily="serif"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_usage_today_opens"
                        android:textColor="@color/text_subtitle"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usage_feature_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/featureUsageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_diary_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/export_diary_desc"
                android:textColor="@color/text_subtitle"
                android:textSize="12sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnExportDiary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/export_diary_btn"
                    android:textSize="14sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_btn_submit_ripple"
                    android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnImportDiary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/import_diary_btn"
                    android:textSize="14sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/green_primary"
                    android:background="@drawable/bg_btn_submit_ripple"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:elevation="4dp"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usage_recent_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/recentDaysContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
