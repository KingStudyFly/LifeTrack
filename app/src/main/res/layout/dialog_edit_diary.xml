<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:minWidth="320dp"
        android:maxHeight="480dp">

        <TextView
            android:id="@+id/tvEditTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diary_edit_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvEditTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brown_period_text"
            android:textSize="12sp"
            android:letterSpacing="0.05"
            android:layout_marginBottom="10dp" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editDiaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="@drawable/bg_card_inner"
                android:padding="16dp"
                android:hint="@string/hint_diary_content"
                android:textColorHint="@color/text_hint"
                android:maxLength="5000"
                android:textColor="@color/text_input"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:scrollbars="none"
                android:overScrollMode="never" />

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/btnDeleteDiary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/diary_delete"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/btnCancelEdit"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/diary_cancel"
                android:textColor="@color/text_subtitle"
                android:textSize="14sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnSaveEdit"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/diary_save"
                android:textColor="@color/green_primary"
                android:textSize="14sp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/btnDialogClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_dialog_close"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/dialog_close" />

</FrameLayout>
