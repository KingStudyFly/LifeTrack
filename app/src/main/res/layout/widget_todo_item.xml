<?xml version="1.0" encoding="utf-8"?>
<!--
  集合视图的单行布局（由 TodoWidgetService 的 RemoteViewsFactory 按需渲染）。

  两个关键点：

  1. 本布局不设背景。半透明磨砂背景由 widget_todo.xml 的容器层统一提供，
     若行自身再设背景，滚动时会形成逐行色块，破坏整体通透感。
  2. 根节点**不要**声明 android:clickable / android:focusable。
     声明后系统会把它当作可交互子项，长按滚动时对该行播放默认的
     按压/缩放动画，表现为「组件被选中缩小」。
     行的点击能力由 ListView 自身处理，RemoteViews 的
     setOnClickPendingIntent 挂在根节点上即可生效，无需 focusable。
     同理背景不设 selector/ripple，避免带出额外状态。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/itemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxLines="1"
        android:shadowColor="#66000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="@string/widget_todo_status_pending"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
